# Shopify store domain without protocol, e.g. your-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token (private app / custom app with write_products, write_files, write_content, and read/write channels scopes)
SHOPIFY_ADMIN_API_TOKEN=

# Storefront API token for the public sales channel used by the MCP harness
SHOPIFY_STOREFRONT_API_TOKEN=

# Optional: override Shopify GraphQL API version (defaults to 2024-10)
SHOPIFY_API_VERSION=

# Optional: base URL for the Shopify Storefront MCP server if different from https://<store-domain>/apps/mcp/storefront
MCP_STOREFRONT_URL=

# Optional: set to true to enable verbose logging from scripts (true/false)
ARC_VERBOSE=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-token
SHOPIFY_API_VERSION=2024-07
