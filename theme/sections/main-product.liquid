{%- if product -%}
  <section class="section-inner product-detail">
    <div class="product-media-gallery">
      {%- for media in product.media -%}
        {%- case media.media_type -%}
          {%- when 'image' -%}
            <figure>
              <img src="{{ media | image_url: width: 1200, format: 'webp' }}" alt="{{ media.alt | escape }}" loading="lazy">
            </figure>
          {%- when 'video' -%}
            {% render 'video-muted', media: media %}
          {%- when 'external_video' -%}
            {% render 'video-muted', media: media %}
          {%- else -%}
            <figure>
              <img src="{{ media | image_url: width: 1200, format: 'webp' }}" alt="{{ media.alt | escape }}" loading="lazy">
            </figure>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="product-info">
      <h1>{{ product.title }}</h1>
      <div class="price">{{ product.selected_or_first_available_variant.price | money }}</div>
      <div class="product-description">{{ product.description }}</div>
      {%- form 'product', product -%}
        <div class="product-options">
          {%- for option in product.options_with_values -%}
            <label>{{ option.name }}</label>
            <select name="options[{{ option.name }}]">
              {%- for value in option.values -%}
                <option value="{{ value }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          {%- endfor -%}
        </div>
        <button type="submit" class="button">Add to cart</button>
      {%- endform -%}
    </div>
  </section>
{%- else -%}
  <p>Product unavailable.</p>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "settings": []
}
{% endschema %}
