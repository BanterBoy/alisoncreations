<section class="section-inner featured-collections">
  <header>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </header>
  <div class="collection-grid">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      {% if collection %}
        <article class="collection-card" {{ block.shopify_attributes }}>
          <a href="{{ collection.url }}">
            {% if collection.image %}
              <img src="{{ collection.image | image_url: width: 900, format: 'webp' }}" alt="{{ collection.image.alt | escape }}" loading="lazy">
            {% elsif collection.products.first.featured_image %}
              <img src="{{ collection.products.first.featured_image | image_url: width: 900, format: 'webp' }}" alt="{{ collection.title | escape }}" loading="lazy">
            {% endif %}
            <div class="collection-card-body">
              <h3>{{ collection.title }}</h3>
              {% if collection.description != blank %}
                <p>{{ collection.description | strip_html | truncate: 120 }}</p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hand-picked resin art from our automation pipeline."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
