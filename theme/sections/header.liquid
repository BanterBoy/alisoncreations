<div class="header-inner">
  <div class="header-brand">
    <a href="/" class="header-logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ section.settings.logo.alt | default: shop.name }}" loading="lazy">
      {%- else -%}
        <span class="header-logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  </div>
  <nav class="header-nav" role="navigation">
    <ul>
      {%- assign menu = section.settings.main_menu | default: 'main-menu' -%}
      {%- for link in linklists[menu].links -%}
        <li>
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul>
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
  <div class="header-cta">
    <a class="button" href="/cart">View cart</a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
