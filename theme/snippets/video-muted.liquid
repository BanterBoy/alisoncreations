{%- assign video = media | default: product_media -%}
{%- if video == blank -%}
  <div class="video-muted--placeholder">Video unavailable</div>
{%- else -%}
  <figure class="video-muted" data-video-muted>
    <video
      muted
      playsinline
      loop
      controls
      preload="metadata"
      {% if video.preview_image %}poster="{{ video.preview_image | img_url: '900x' }}"{% endif %}
    >
      {%- if video.sources -%}
        {%- for source in video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      {%- elsif video.media_content_type == 'EXTERNAL_VIDEO' -%}
        <source src="{{ video.external_url }}">
      {%- endif -%}
      Your browser does not support muted video playback.
    </video>
  </figure>
{%- endif -%}
